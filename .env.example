# ─────────────────────────────────────────────────────────────
#  Regulatory Intelligence — конфигурация
#  Заполните этот файл и сохраните. НЕ публикуйте его нигде.
# ─────────────────────────────────────────────────────────────

# ── Confluence ───────────────────────────────────────────────

# Адрес вашего Confluence Cloud (без слеша в конце)
# Пример: https://mycompany.atlassian.net
CONFLUENCE_URL=https://YOUR_COMPANY.atlassian.net

# Email аккаунта Atlassian (тот, под которым вы входите)
CONFLUENCE_EMAIL=your.email@company.com

# API-токен Atlassian
# Создать здесь: https://id.atlassian.com/manage-api-tokens
# Нажмите "Create API token", дайте имя (например "RI App"), скопируйте токен
CONFLUENCE_TOKEN=YOUR_API_TOKEN_HERE

# Ключ пространства Confluence (Space Key)
# Виден в URL: .../wiki/spaces/RI/... — здесь ключ RI
# Или зайдите в Space Settings → Overview → Space Key
CONFLUENCE_SPACE=RI

# ID родительской страницы (необязательно)
# Если хотите, чтобы все страницы RI создавались внутри определённого раздела
# Найдите страницу в Confluence, ID виден в URL: .../pages/123456789/...
# Оставьте пустым, если хотите создавать страницы в корне пространства
CONFLUENCE_PARENT_ID=
